# Managed environment — everything runs through `pixi run`
/.pixi

# Run outputs: checkpoints, metrics, evaluation, logs, per-cell runtime
# profiles and recorded traffic all land under one root. The deterministic
# recordings that are evaluation ground truth are package data
# (opencda_marl/_bundled/recordings/), not output, and stay tracked.
/artifacts
*.log

# Perception model weights, downloaded on demand (learner checkpoints are
# .pth and the bundled baselines are tracked package data).
*.pt

# Generated documentation
/site
docs/_build/

# Local scratch and linked worktrees
/.tmp
/.worktree

# Local AI tool state (including the preview tools' launch.json), not part
# of the project source.
.claude/
